# MongoDB Atlas Credentials Template
# Rename or copy this to atlas-credentials.env or .env for local development

MONGODB_USERNAME="your_username_here"
MONGODB_PASSWORD="your_password_here"
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.your_cluster.mongodb.net/?retryWrites=true&w=majority"

